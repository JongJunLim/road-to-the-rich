# ---------- 데이터 ----------
# demo | private
DATA_MODE=demo

# private 모드에서만 사용 — 로컬 파일 경로 또는 비공개 버킷
#   로컬:  SNAPSHOT_SOURCE=.private/snapshot.json   (npm run dev:real 이 자동 설정)
#   운영:  SNAPSHOT_SOURCE=gs://your-private-bucket/snapshot/latest.json
SNAPSHOT_SOURCE=

# ---------- 로그인 ----------
# true 면 Google 로그인 + 허용 목록 검사 (private 모드 운영 배포에는 필수)
AUTH_ENABLED=false

# 접속 허용 Google 계정 (쉼표 구분)
ALLOWED_EMAILS=you@gmail.com,partner@gmail.com

# Firebase 웹 앱 설정 (Firebase 콘솔 → 프로젝트 설정 → 내 앱) — 공개 식별자
FIREBASE_API_KEY=
# 운영(Cloud Run)은 self 권장 — 접속한 주소를 로그인 도메인으로 사용 (localhost 는 자동으로 firebaseapp.com)
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project
FIREBASE_APP_ID=
